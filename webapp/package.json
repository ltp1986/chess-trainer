{
  "name": "chess-trainer",
  "version": "1.0.0",
  "description": "国际象棋习题训练系统",
  "main": "app.js",
  "scripts": {
    "start": "python app.py",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern 'unit' --passWithNoTests",
    "test:integration": "jest --testPathPattern 'integration.unit' --passWithNoTests",
    "test:integration:live": "node start-server.js",
    "test:api": "jest --testPathPattern 'api.unit' --passWithNoTests",
    "test:board": "jest --testPathPattern 'board-utils' --passWithNoTests",
    "test:validation": "jest --testPathPattern 'validation' --passWithNoTests",
    "test:full": "npm run lint && npm run test:unit && npm run test:integration && npm run test:board && npm run test:validation",
    "test:report": "node run-tests-with-report.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pre-commit": "npm run lint && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-json-reporter": "^1.2.2",
    "jest-junit": "^17.0.0"
  },
  "keywords": [
    "chess",
    "training",
    "exercise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2"
  }
}
